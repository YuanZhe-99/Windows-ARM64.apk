# LF everywhere, also in Windows working trees (gofmt and clang-format expect it).
* text=auto eol=lf
*.png binary
*.ico binary
*.jar binary
*.apk binary
*.so binary
*.dll binary
*.dylib binary
*.svg text eol=lf
*.patch text eol=lf
# A unified diff requires a space on blank context lines.
scripts/windows/angle-toolchain.patch whitespace=-blank-at-eol
